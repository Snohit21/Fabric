        "name": "LookupOldWaterMarkActivity",
        "description": "Create a lookup activity to get the last watermark value. We'll get the default value 1/1/2010 12:00:00 AM that we set earlier.",
        "dependsOn": []
      },
      {
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "DataWarehouseSource",
            "sqlReaderQuery": "Select max(LastModifiedDate) as NewWatermarkValue from data_source_table",
            "partitionOption": "None",
            "queryTimeout": "02:00:00"
          },
          "datasetSettings": {
            "type": "DataWarehouseTable",
            "typeProperties": {
              "schema": "dbo",
              "table": "data_source_table"
            },
            "schema": [],
            "linkedService": {
              "name": "Data_Source",
              "properties": {
                "type": "DataWarehouse",
                "typeProperties": {
                  "artifactId": "008c16ac-c939-9493-4a01-b3cd6d6ad4d3",
